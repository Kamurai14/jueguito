<file path="lib/ui/pantalla_carga.dart">
import 'package:flutter/material.dart';
import 'package:jueguito/servicios/servicio_auth.dart';
import 'package:jueguito/ui/pantalla_login.dart';
import 'package:jueguito/ui/pantalla_seleccion_mapas.dart';

class PantallaCarga extends StatefulWidget {
  const PantallaCarga({super.key});

  @override
  State<PantallaCarga> createState() => _PantallaCargaState();
}

class _PantallaCargaState extends State<PantallaCarga> {
  @override
  void initState() {
    super.initState();
    _verificarSesion();
  }

  void _verificarSesion() async {
    // Le damos un pequeño delay solo para que la animación de carga se vea fluida
    await Future.delayed(const Duration(milliseconds: 800));
    
    final tieneSesion = await ServicioAuth().tieneSesionActiva();

    if (!mounted) return;

    if (tieneSesion) {
      // Si ya hay token, va directo a los mapas
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (context) => const PantallaSeleccionMapas()),
      );
    } else {
      // Si no hay token, lo mandamos al Login
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (context) => const PantallaLogin()),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    // Usamos el mismo color "cremita" de la caja del juego
    return const Scaffold(
      backgroundColor: Color(0xFFF8F5EE),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Text(
              'BRILLIANT',
              style: TextStyle(
                fontSize: 40,
                fontWeight: FontWeight.w900,
                color: Color(0xFFFF6B00), // Naranja Brilliant
                letterSpacing: 2,
              ),
            ),
            SizedBox(height: 30),
            CircularProgressIndicator(color: Color(0xFFE30059)), // Rosa Brilliant
          ],
        ),
      ),
    );
  }
}
</file>

<file path="lib/utils/validador_auth.dart">
class ValidadorAuth {
  static String? validarRegistro(String usuario, String password, String confirmarPassword) {
    if (usuario.isEmpty || password.isEmpty) return 'Por favor, llena todos los campos obligatorios.';
    
    if (usuario.length < 3 || usuario.length > 15) {
      return 'El usuario debe tener entre 3 y 15 caracteres.';
    }
    
    if (!RegExp(r'^[a-zA-Z0-9_]+$').hasMatch(usuario)) {
      return 'El usuario no puede contener espacios ni símbolos especiales.';
    }
    
    if (password.length < 6) return 'La contraseña debe tener al menos 6 caracteres.';
    
    if (password != confirmarPassword) return 'Las contraseñas no coinciden.';
    
    return null; // null significa que todo está correcto
  }
}
</file>

